# Copy this file to .env and replace every placeholder outside version control.
# Do not commit credentials, tokens, URLs for private environments, or FCM material.
# PostgreSQL must be the already migrated service from AlertaMujer_Database.
COMPOSE_PROJECT_NAME=alertamujer-backend
BACKEND_HOST_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5434/alertamujer_db
SPRING_DATASOURCE_USERNAME=alertamujer_app
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_LOCAL_APPLICATION_PASSWORD
JWT_SECRET=REPLACE_WITH_LOCAL_JWT_SECRET
CORS_ALLOWED_ORIGINS=http://localhost:8081
FCM_CREDENTIALS_PATH=REPLACE_WITH_FCM_CREDENTIALS_PATH
EVIDENCE_STORAGE_PATH=/var/lib/alertamujer/evidence
EVIDENCE_VOLUME_NAME=alertamujer_backend_evidence

# SMTP is required when emitting EMAIL OTPs. Keep its real credentials only in .env.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_FROM=REPLACE_WITH_VERIFIED_SENDER_EMAIL
